.container {
  min-height: 100vh;
  background: #eff6ff;
  padding-bottom: 32rpx;
}

.section {
  padding: 28rpx 32rpx;
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.title-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.title-text {
  font-size: calc(32rpx * var(--font-scale, 1));
  font-weight: bold;
  color: #1F2937;
}

.setting-card {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.setting-item {
  display: flex;
  align-items: center;
  padding: 26rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-info {
  flex: 1;
}

.setting-label {
  font-size: calc(30rpx * var(--font-scale, 1));
  color: #1F2937;
  display: block;
}

.setting-desc {
  font-size: calc(24rpx * var(--font-scale, 1));
  color: #9ca3af;
  margin-top: 6rpx;
  display: block;
}

.setting-arrow {
  margin-left: 16rpx;
}

.arrow-icon {
  font-size: 26rpx;
  color: #9ca3af;
}

.language-options {
  padding: 0;
}

.language-item {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.language-item:last-child {
  border-bottom: none;
}

.language-item.active {
  background: #eff6ff;
}

.language-info {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.language-left {
  flex: 1;
}

.language-right {
  flex-shrink: 0;
}

.language-label {
  font-size: calc(28rpx * var(--font-scale, 1));
  color: #1F2937;
}

.language-desc {
  font-size: calc(24rpx * var(--font-scale, 1));
  color: #9ca3af;
}

.language-check {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #d1d5db;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.language-item.active .language-check {
  background: #3b82f6;
  border-color: #3b82f6;
}

.check-icon {
  font-size: 24rpx;
  color: #ffffff;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: calc(34rpx * var(--font-scale, 1));
  font-weight: bold;
  color: #1F2937;
  text-align: center;
  margin-bottom: 32rpx;
}

.font-size-options {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.font-size-option {
  width: 48%;
  padding: 24rpx;
  background: #f9fafb;
  border-radius: 16rpx;
  text-align: center;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}

.font-size-option.active {
  border-color: #3b82f6;
  background: #eff6ff;
}

.font-size-label {
  font-size: 28rpx;
  color: #374151;
  display: block;
}

.font-size-preview {
  margin-top: 8rpx;
}

.font-size-preview text {
  color: #6b7280;
}

.modal-actions {
  margin-top: 32rpx;
}

.modal-btn {
  padding: 24rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: calc(30rpx * var(--font-scale, 1));
}

.confirm-btn {
  background: #3b82f6;
  color: #ffffff;
}