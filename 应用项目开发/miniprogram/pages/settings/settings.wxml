<view class="container" style="--font-scale: {{fontScale}};">
  <view class="section">
    <view class="section-title">
      <text class="title-icon">🎨</text>
      <text class="title-text">{{locale.settingsDisplaySettings || '显示设置'}}</text>
    </view>

    <view class="setting-card">
      <view class="setting-item" bindtap="showFontSizeModal">
        <view class="setting-info">
          <text class="setting-label">{{locale.settingsFontSize || '字体大小'}}</text>
          <text class="setting-desc">{{locale.settingsCurrent || '当前'}}：{{fontSizeLabel}}</text>
        </view>
        <view class="setting-arrow">
          <text class="arrow-icon">→</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">
      <text class="title-icon">🌐</text>
      <text class="title-text">{{locale.settingsLanguage || '语言设置'}}</text>
    </view>

    <view class="setting-card">
      <view class="language-options">
        <view 
          class="language-item {{language === item.value ? 'active' : ''}}" 
          wx:for="{{languageOptions}}" 
          wx:key="value"
          bindtap="setLanguage"
          data-value="{{item.value}}"
        >
          <view class="language-info">
            <view class="language-left">
              <text class="language-label">{{item.label}}</text>
            </view>
            <view class="language-right">
              <text class="language-desc">{{item.desc}}</text>
            </view>
          </view>
          <view class="language-check" wx:if="{{language === item.value}}">
            <text class="check-icon">✓</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="setting-card">
      <view class="setting-item" bindtap="resetSettings">
        <view class="setting-info">
          <text class="setting-label">{{locale.settingsReset || '恢复默认设置'}}</text>
          <text class="setting-desc">{{locale.settingsResetDesc || '将所有设置恢复为默认值'}}</text>
        </view>
        <view class="setting-arrow">
          <text class="arrow-icon">→</text>
        </view>
      </view>
    </view>
  </view>
</view>

<view class="modal-overlay" wx:if="{{showFontModal}}" bindtap="closeFontModal">
  <view class="modal-content" catchtap="preventClose">
    <text class="modal-title">{{locale.settingsSelectFontSize || '选择字体大小'}}</text>
    <view class="font-size-options">
      <view 
        class="font-size-option {{fontSize === item.value ? 'active' : ''}}" 
        wx:for="{{fontSizeOptions}}" 
        wx:key="value"
        bindtap="setFontSize"
        data-value="{{item.value}}"
      >
        <text class="font-size-label">{{item.label}}</text>
      </view>
    </view>
    <view class="modal-actions">
      <view class="modal-btn confirm-btn" bindtap="closeFontModal">
        <text>{{locale.settingsConfirm || '确定'}}</text>
      </view>
    </view>
  </view>
</view>
