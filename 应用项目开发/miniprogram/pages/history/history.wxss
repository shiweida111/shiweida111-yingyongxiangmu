page {
  background: #eff6ff;
  min-height: 100vh;
}

.container {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: 120rpx;
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 36rpx;
  color: #6b7280;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 28rpx;
  color: #9ca3af;
  margin-top: 12rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
}

.record-item {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  position: relative;
}

.record-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.record-type {
  display: flex;
  align-items: center;
  padding: 10rpx 16rpx;
  border-radius: 20rpx;
}

.record-type.deepfake {
  background: #eff6ff;
}

.record-type.fraud {
  background: #f5f3ff;
}

.record-type.chat_fraud {
  background: #eef2ff;
}

.type-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.type-text {
  font-size: 24rpx;
  color: #374151;
}

.record-time {
  font-size: 24rpx;
  color: #9ca3af;
}

.record-content {
  display: flex;
}

.record-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
}

.record-result {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.result-label {
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 8rpx;
}

.result-text {
  font-size: 28rpx;
  color: #1F2937;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
}

.clear-btn {
  margin-top: 32rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.clear-text {
  font-size: 30rpx;
  color: #ef4444;
}

.record-arrow {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
}

.arrow-icon {
  font-size: 28rpx;
  color: #9ca3af;
}