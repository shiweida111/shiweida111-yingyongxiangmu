.container {
  min-height: 100vh;
  background: #eff6ff;
  padding-bottom: 120rpx;
}

.user-section {
  background: #3b82f6;
  padding: 48rpx 32rpx;
  border-radius: 0 0 48rpx 48rpx;
}

.user-card {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  padding: 28rpx;
}

.avatar-area {
  position: relative;
  margin-right: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.avatar-edit {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 40rpx;
  height: 40rpx;
  background: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-icon {
  font-size: 22rpx;
  color: #3b82f6;
  font-weight: bold;
}

.user-info {
  flex: 1;
}

.nickname-row {
  display: flex;
  align-items: center;
}

.nickname {
  font-size: calc(34rpx * var(--font-scale, 1));
  font-weight: bold;
  color: #ffffff;
  margin-right: 14rpx;
}

.nickname-edit {
  padding: 6rpx 14rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
}

.edit-text {
  font-size: calc(22rpx * var(--font-scale, 1));
  color: #ffffff;
}

.user-id {
  font-size: calc(22rpx * var(--font-scale, 1));
  color: rgba(255, 255, 255, 0.7);
  margin-top: 6rpx;
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 40rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}

.login-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.login-text {
  font-size: calc(30rpx * var(--font-scale, 1));
  color: #ffffff;
  font-weight: 500;
}

.menu-section {
  padding: 28rpx 32rpx;
}

.menu-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 8rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 26rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 38rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: calc(30rpx * var(--font-scale, 1));
  color: #374151;
}

.menu-arrow {
  font-size: 26rpx;
  color: #9ca3af;
}

.logout-btn {
  margin: 28rpx 32rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.logout-text {
  font-size: calc(30rpx * var(--font-scale, 1));
  color: #ef4444;
}

.footer {
  text-align: center;
  padding: 48rpx 0;
}

.version {
  font-size: calc(24rpx * var(--font-scale, 1));
  color: #9ca3af;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: calc(34rpx * var(--font-scale, 1));
  font-weight: bold;
  color: #1F2937;
  text-align: center;
  margin-bottom: 32rpx;
}

.nickname-input {
  width: 100%;
  padding: 24rpx;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  font-size: calc(30rpx * var(--font-scale, 1));
  margin-bottom: 32rpx;
}

.modal-actions {
  display: flex;
}

.modal-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: calc(30rpx * var(--font-scale, 1));
}

.cancel-btn {
  background: #f3f4f6;
  color: #6b7280;
  margin-right: 16rpx;
}

.confirm-btn {
  background: #3b82f6;
  color: #ffffff;
}