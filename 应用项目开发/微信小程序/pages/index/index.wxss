.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1d1d1f;
  display: block;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #86868b;
}

.upload-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-plus {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #8b5cf6;
  border-radius: 16rpx;
  position: relative;
}

.icon-plus::before {
  content: '';
  position: absolute;
  width: 30rpx;
  height: 4rpx;
  background: #8b5cf6;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.icon-plus::after {
  content: '';
  position: absolute;
  width: 4rpx;
  height: 30rpx;
  background: #8b5cf6;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.upload-text {
  font-size: 30rpx;
  color: #3c3c3c;
  font-weight: 500;
  display: block;
  margin-bottom: 12rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: #86868b;
}

.section {
  margin-bottom: 40rpx;
}

.result-content {
  padding-bottom: 30rpx;
}

.warning-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #bf9b00;
  display: block;
  margin-bottom: 12rpx;
}

.warning-text {
  font-size: 26rpx;
  color: #866d00;
  line-height: 1.6;
}

.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #007aff;
  display: block;
  margin-bottom: 12rpx;
}

.tips-list {
  padding-left: 20rpx;
}

.tip-item {
  font-size: 26rpx;
  color: #3c3c3c;
  line-height: 1.7;
  display: block;
  margin-bottom: 8rpx;
}