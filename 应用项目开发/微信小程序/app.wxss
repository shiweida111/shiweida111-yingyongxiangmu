page {
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", "Microsoft YaHei", sans-serif;
  background: linear-gradient(135deg, #f5f7fa 0%, #e4e8ec 50%, #f0f2f5 100%);
  min-height: 100vh;
}

.container {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card {
  width: 100%;
  max-width: 650rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  background: #007aff;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 122, 255, 0.3);
  transition: all 0.3s ease;
}

.btn-primary:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-secondary {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #30d158 0%, #34c759 100%);
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(48, 209, 88, 0.3);
  transition: all 0.3s ease;
}

.btn-clear {
  width: 100%;
  height: 88rpx;
  background: #86868b;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1d1d1f;
  padding-bottom: 16rpx;
  border-bottom: 6rpx solid #007aff;
  margin-top: 40rpx;
}

.section-title:first-child {
  margin-top: 0;
}

.list-item {
  margin-top: 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #3c3c3c;
}

.warning-box {
  margin-top: 32rpx;
  padding: 24rpx;
  background: rgba(255, 204, 0, 0.08);
  border-radius: 16rpx;
  border-left: 8rpx solid #ffcc00;
}

.warning-box h4 {
  color: #bf9b00;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.warning-box p {
  color: #866d00;
  font-size: 26rpx;
  line-height: 1.6;
}

.tips-area {
  margin-top: 32rpx;
  padding: 24rpx;
  background: rgba(0, 122, 255, 0.05);
  border-radius: 16rpx;
  border-left: 8rpx solid #007aff;
}

.tips-area h4 {
  color: #007aff;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.tips-area li {
  color: #3c3c3c;
  font-size: 26rpx;
  line-height: 1.7;
  margin-bottom: 8rpx;
}

.upload-area {
  border: 4rpx dashed rgba(148, 163, 184, 0.4);
  border-radius: 24rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.6);
}

.upload-area:active {
  border-color: #8b5cf6;
  background: rgba(139, 92, 246, 0.05);
}

.preview-img {
  width: 100%;
  max-height: 500rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.filename {
  margin-top: 20rpx;
  color: #86868b;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 12rpx;
  display: inline-block;
}

.loading-text {
  color: #86868b;
  font-size: 28rpx;
  margin-top: 20rpx;
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid rgba(139, 92, 246, 0.2);
  border-top-color: #8b5cf6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}