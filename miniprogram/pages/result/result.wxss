page {
  background: #eff6ff;
  min-height: 100vh;
}

.back-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.back-icon {
  font-size: 40rpx;
  color: #3b82f6;
}

.back-text {
  font-size: 30rpx;
  color: #3b82f6;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #e0e0e0;
  border-top-color: #3b82f6;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
}

.result-content {
  padding-bottom: 40rpx;
}

.image-card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.result-image {
  width: 100%;
  height: 500rpx;
}

.result-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.result-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.result-badge {
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.result-badge.fake {
  background: #fef2f2;
  color: #ef4444;
}

.result-badge.real {
  background: #f0fdf4;
  color: #22c55e;
}

.probability-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
  background: #f5f7fa;
  border-radius: 20rpx;
  margin-bottom: 28rpx;
}

.probability-circle {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.probability-value {
  font-size: 96rpx;
  font-weight: 700;
  color: #3b82f6;
}

.probability-unit {
  font-size: 32rpx;
  color: #999999;
}

.probability-label {
  font-size: 28rpx;
  color: #666666;
}

.risk-section {
  background: #fffbeb;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
}

.risk-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.risk-icon {
  font-size: 32rpx;
}

.risk-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #f59e0b;
}

.risk-bar {
  height: 12rpx;
  background: #fde68a;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.risk-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.risk-fill.low {
  background: #22c55e;
}

.risk-fill.medium {
  background: #f59e0b;
}

.risk-fill.high {
  background: #ef4444;
}

.risk-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.risk-score {
  font-size: 28rpx;
  color: #666666;
}

.risk-details {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.detail-item {
  font-size: 26rpx;
  color: #b45309;
  background: rgba(250, 204, 21, 0.15);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
  display: block;
}

.radar-section {
  margin-bottom: 28rpx;
}

.radar-canvas {
  width: 100%;
  height: 300rpx;
  margin-bottom: 24rpx;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.feature-name {
  width: 140rpx;
  font-size: 26rpx;
  color: #666666;
}

.feature-bar-container {
  flex: 1;
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.feature-bar {
  height: 100%;
  background: #3b82f6;
  border-radius: 6rpx;
}

.feature-value {
  width: 80rpx;
  font-size: 26rpx;
  color: #3b82f6;
  text-align: right;
}

.analysis-section {
  margin-bottom: 28rpx;
}

.analysis-content {
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 24rpx;
}

.analysis-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.8;
  white-space: pre-wrap;
}

.action-section {
  display: flex;
  gap: 24rpx;
}

.action-btn {
  flex: 1;
  padding: 28rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
}

.action-btn.primary {
  background: #3b82f6;
  color: #ffffff;
  border: none;
}

.action-btn.secondary {
  background: #f5f5f5;
  color: #333333;
  border: 2rpx solid #e0e0e0;
}