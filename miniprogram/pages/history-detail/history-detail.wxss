.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 40rpx;
}

.header {
  position: relative;
  height: 120rpx;
  padding-top: 44rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 164rpx;
  background: linear-gradient(135deg, #3b82f6 0%, #6366f1 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.header-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  height: 80rpx;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.back-icon {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: bold;
}

.header-title {
  flex: 1;
  text-align: center;
}

.title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.header-placeholder {
  width: 64rpx;
}

.detail-card {
  margin: -20rpx 24rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.record-type {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.type-icon {
  font-size: 36rpx;
}

.type-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.record-time {
  font-size: 24rpx;
  color: #9ca3af;
}

.image-section {
  padding: 24rpx 32rpx;
  background: #f8fafc;
}

.image-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.label-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.hint-text {
  font-size: 22rpx;
  color: #9ca3af;
}

.detail-image {
  width: 100%;
  max-height: 400rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.result-section {
  padding: 24rpx 32rpx;
}

.result-header {
  margin-bottom: 16rpx;
}

.result-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.result-content {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 24rpx;
  max-height: 600rpx;
}

.result-text {
  font-size: 28rpx;
  color: #475569;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}