page {
  background: #eff6ff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  --font-scale: 1;
  font-size: calc(28rpx * var(--font-scale));
}

.font-xs { font-size: calc(22rpx * var(--font-scale)); }
.font-sm { font-size: calc(24rpx * var(--font-scale)); }
.font-base { font-size: calc(28rpx * var(--font-scale)); }
.font-lg { font-size: calc(32rpx * var(--font-scale)); }
.font-xl { font-size: calc(36rpx * var(--font-scale)); }
.font-xxl { font-size: calc(40rpx * var(--font-scale)); }

.container {
  padding: 20rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 20rpx;
}

.btn-primary {
  background: #3b82f6;
  color: #ffffff;
  border: none;
  border-radius: 40rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.3);
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-secondary {
  background: #f5f5f5;
  color: #333333;
  border: 2rpx solid #e0e0e0;
  border-radius: 40rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
}

.btn-secondary:active {
  background: #eeeeee;
}

.flex {
  display: flex;
}

.flex-col {
  flex-direction: column;
}

.items-center {
  align-items: center;
}

.justify-center {
  justify-content: center;
}

.justify-between {
  justify-content: space-between;
}

.gap-16 {
  gap: 16rpx;
}

.gap-24 {
  gap: 24rpx;
}

.text-center {
  text-align: center;
}

.text-primary {
  color: #3b82f6;
}

.text-danger {
  color: #ef4444;
}

.text-success {
  color: #22c55e;
}

.text-warning {
  color: #f59e0b;
}

.mt-24 {
  margin-top: 24rpx;
}

.mb-24 {
  margin-bottom: 24rpx;
}

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}