<view class="container" style="--font-scale: {{fontScale || 1}};">
  <view class="header">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="logo-area">
        <view class="logo">
          <text class="logo-icon">🛡️</text>
        </view>
        <view class="logo-ring"></view>
      </view>
      <view class="title-section">
        <text class="main-title">{{locale.appName}}</text>
        <text class="sub-title">{{locale.appDesc}}</text>
      </view>
    </view>
    <view class="header-decoration"></view>
  </view>

  <view class="function-section">
    <text class="section-title">{{locale.selectFunction}}</text>
    <view class="function-grid">
      <view class="function-card deepfake-card" bindtap="goToDetect">
        <view class="card-icon-box">
          <view class="card-icon">🎨</view>
        </view>
        <view class="card-info">
          <text class="card-title">{{locale.deepfake}}</text>
          <text class="card-desc">{{locale.deepfakeDesc}}</text>
        </view>
        <view class="card-arrow">
          <text class="arrow-icon">→</text>
        </view>
        <view class="card-glow"></view>
      </view>

      <view class="function-card fraud-card" bindtap="goToFraudDetect">
        <view class="card-icon-box">
          <view class="card-icon">🛡️</view>
        </view>
        <view class="card-info">
          <text class="card-title">{{locale.fraud}}</text>
          <text class="card-desc">{{locale.fraudDesc}}</text>
        </view>
        <view class="card-arrow">
          <text class="arrow-icon">→</text>
        </view>
        <view class="card-glow"></view>
      </view>

      <view class="function-card chat-card" bindtap="goToChatFraudDetect">
        <view class="card-icon-box">
          <view class="card-icon">💬</view>
        </view>
        <view class="card-info">
          <text class="card-title">{{locale.chatFraud}}</text>
          <text class="card-desc">{{locale.chatFraudDesc}}</text>
        </view>
        <view class="card-arrow">
          <text class="arrow-icon">→</text>
        </view>
        <view class="card-glow"></view>
      </view>
    </view>
  </view>

  <view class="tips-section">
    <view class="tips-card">
      <view class="tips-header">
        <view class="tips-icon-wrapper">
          <text class="tips-icon">💡</text>
        </view>
        <text class="tips-title">{{locale.tips}}</text>
      </view>
      <view class="tips-content">
        <view class="tip-item">
          <text class="tip-num">1</text>
          <text class="tip-text">{{locale.tip1}}</text>
        </view>
        <view class="tip-item">
          <text class="tip-num">2</text>
          <text class="tip-text">{{locale.tip2}}</text>
        </view>
        <view class="tip-item">
          <text class="tip-num">3</text>
          <text class="tip-text">{{locale.tip3}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="footer">
    <text class="footer-text">{{locale.footer}}</text>
    <text class="footer-version">{{locale.version}}</text>
  </view>
</view>