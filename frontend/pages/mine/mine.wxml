<view class="container" style="--font-scale: {{fontScale}};">
  <view class="user-section">
    <view class="user-card">
      <view class="avatar-area" bindtap="chooseAvatar">
        <image class="avatar" src="{{userInfo.avatarUrl || '/images/placeholder.png'}}" mode="aspectFill" />
        <view class="avatar-edit">
          <text class="edit-icon">✎</text>
        </view>
      </view>
      <view class="user-info">
        <view class="nickname-row">
          <text class="nickname">{{userInfo.nickName || locale.mineClickToLogin}}</text>
          <view class="nickname-edit" bindtap="editNickname" wx:if="{{userInfo.nickName}}">
            <text class="edit-text">{{locale.mineSetNickname}}</text>
          </view>
        </view>
        <text class="user-id">ID: {{userInfo.userId || locale.mineNotLoggedIn}}</text>
      </view>
    </view>

    <view class="login-btn" wx:if="{{!isLoggedIn}}" bindtap="wxLogin">
      <text class="login-icon">📱</text>
      <text class="login-text">{{locale.mineLogin}}</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-card">
      <view class="menu-item" bindtap="goToHistory">
        <view class="menu-icon">📋</view>
        <text class="menu-text">{{locale.mineHistory}}</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bindtap="showSettings">
        <view class="menu-icon">⚙️</view>
        <text class="menu-text">{{locale.mineSettings}}</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bindtap="showAbout">
        <view class="menu-icon">ℹ️</view>
        <text class="menu-text">{{locale.mineAbout}}</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bindtap="showPrivacy">
        <view class="menu-icon">🔒</view>
        <text class="menu-text">{{locale.minePrivacy}}</text>
        <text class="menu-arrow">→</text>
      </view>
    </view>
  </view>

  <view class="logout-btn" wx:if="{{isLoggedIn}}" bindtap="logout">
    <text class="logout-text">{{locale.mineLogout}}</text>
  </view>

  <view class="footer">
    <text class="version">{{locale.version}}</text>
  </view>
</view>

<view class="modal-overlay" wx:if="{{showNicknameModal}}" bindtap="closeModal">
  <view class="modal-content" catchtap="preventClose">
    <text class="modal-title">{{locale.mineSetNickname}}</text>
    <input class="nickname-input" placeholder="{{locale.minePleaseInputNickname}}" value="{{tempNickname}}" bindinput="onNicknameInput" />
    <view class="modal-actions">
      <view class="modal-btn cancel-btn" bindtap="closeModal">
        <text>{{locale.mineCancel || '取消'}}</text>
      </view>
      <view class="modal-btn confirm-btn" bindtap="saveNickname">
        <text>{{locale.mineSave || '保存'}}</text>
      </view>
    </view>
  </view>
</view>
